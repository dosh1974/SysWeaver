<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>SysWeaver.TextMessage</RootNamespace>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Features>runtime-async=on</Features>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SysWeaver.Common\SysWeaver.Common.csproj" />
    <ProjectReference Include="..\..\SysWeaver.IsoData\SysWeaver.IsoData.csproj" />
    <ProjectReference Include="..\..\SysWeaver.MicroServices.ServiceManager\SysWeaver.MicroServices.ServiceManager.csproj" />
    <ProjectReference Include="..\..\SysWeaver.TableData\SysWeaver.TableData.csproj" />
  </ItemGroup>

  <Target Name="EmbedLocal" BeforeTargets="BeforeBuild">
    <Exec Command="..\..\_tools\compress\Compress.exe -Methods br .\srcWeb\fakeText\* .\web\fakeText" />
    <ItemGroup>
      <EmbeddedResource Include="web\**\*.br" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
