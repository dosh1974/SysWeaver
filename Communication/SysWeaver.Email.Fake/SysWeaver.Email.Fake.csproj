<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SysWeaver.Email</RootNamespace>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SysWeaver.Common\SysWeaver.Common.csproj" />
    <ProjectReference Include="..\..\SysWeaver.MicroServices\SysWeaver.MicroServices.csproj" />
    <ProjectReference Include="..\..\SysWeaver.MicroServices.ServiceManager\SysWeaver.MicroServices.ServiceManager.csproj" />
    <ProjectReference Include="..\..\SysWeaver.TableData\SysWeaver.TableData.csproj" />
  </ItemGroup>

  <Target Name="EmbedLocal" BeforeTargets="BeforeBuild">
    <Exec Command="..\..\_tools\compress\Compress.exe -Methods br .\srcWeb\fakeEmail\* .\web\fakeEmail" />
    <ItemGroup>
      <EmbeddedResource Include="web\**\*.br" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
