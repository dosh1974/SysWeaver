{
  "start_url": "../",
  "scope": "../",
  "short_name": "${$EnvInfo.AppName}",
  "name": "${$EnvInfo.AppDisplayName}",
  "icons": [
    {
      "src": "../icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "../icon-180.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "../icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "../icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "display": "fullscreen",
  "orientation": "any",
  "description": "${$EnvInfo.AppDescription}",
  "theme_color": "${$Color.Color}",
  "background_color": "${$Color.Background}",
  "screenshots": [
    {
      "src": "../logo.svg",
      "sizes": "1024x768",
      "type": "image/svg+xml"
    }
  ],
  "sysweaver_optimized_send": "${Client.OptimizedSend}"
}