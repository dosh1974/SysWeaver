<Project Sdk="Microsoft.NET.Sdk">

  <!--
    GLSL effects (ShaderToy / GlslSandbox style, the Effect Weaver format): parsing (variables, iMouse channels), the Ew snippet library
    (Snippets\, inserted when an effect is built), the optional vertex stage and the final WebGL program source.
    Shared by SysWeaver's media player (MediaService.BuildEffect) and Effect Weaver (Effect Saver, VjWeaver, the editor), so an effect
    loads the same way everywhere. The code keeps Effect Weaver's namespace (EffectWeaver.Shaders) and style (it was EffectWeaver.Common\Shaders).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EffectWeaver.Shaders</RootNamespace>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591;1573</NoWarn>
  </PropertyGroup>

  <!--
    The snippet library: Effect Weaver's _snippets (D:\EffectWeaver\_snippets, next to this repository) is the source (edited in the Effect Weaver
    editor, documented there). When it exists its .glsl files are copied to Snippets\ before the build, so the copy here stays in sync and a
    checkout without Effect Weaver still builds the same library.
  -->
  <PropertyGroup>
    <EwSnippetSource>$(MSBuildThisFileDirectory)..\..\EffectWeaver\_snippets\</EwSnippetSource>
  </PropertyGroup>
  <Target Name="SyncEwSnippets" BeforeTargets="BeforeBuild" Condition="Exists('$(EwSnippetSource)')">
    <ItemGroup>
      <EwSnippet Include="$(EwSnippetSource)**\*.glsl" Exclude="$(EwSnippetSource)effects\**;$(EwSnippetSource)tools\**" />
    </ItemGroup>
    <Copy SourceFiles="@(EwSnippet)" DestinationFiles="@(EwSnippet->'$(MSBuildThisFileDirectory)Snippets\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <!-- Snippets added since the project was evaluated -->
    <ItemGroup>
      <EmbeddedResource Remove="Snippets\**\*.glsl" />
      <EwSnippetFile Include="Snippets\**\*.glsl" />
      <EmbeddedResource Include="@(EwSnippetFile)" LogicalName="snippets/%(EwSnippetFile.RecursiveDir)%(EwSnippetFile.Filename)%(EwSnippetFile.Extension)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- The built in snippet library (SnippetLibrary.Builtin), resource names "snippets/<folder>/<Id>.glsl" -->
    <EmbeddedResource Include="Snippets\**\*.glsl" LogicalName="snippets/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
