<Project Sdk="Microsoft.NET.Sdk">

  <!--
    GLSL effects (ShaderToy / GlslSandbox style, the Effect Weaver format): parsing (variables, iMouse channels), the Ew snippet library
    (Snippets\, inserted when an effect is built), the optional vertex stage and the final WebGL program source.
    Shared by SysWeaver's media player (MediaService.BuildEffect) and Effect Weaver (Effect Saver, VjWeaver, the editor), so an effect
    loads the same way everywhere. The code keeps Effect Weaver's namespace (EffectWeaver.Shaders) and style (it was EffectWeaver.Common\Shaders).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EffectWeaver.Shaders</RootNamespace>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591;1573</NoWarn>
  </PropertyGroup>

  <!--
    The snippet library: Effect Weaver's _snippets (D:\EffectWeaver\_snippets, next to this repository) is the source (edited in the Effect Weaver
    editor, documented there). When it exists its .glsl files are copied to srcData\ before the build, so the copy here stays in sync and a
    checkout without Effect Weaver still builds the same library.
  -->
  <PropertyGroup>
    <EwSnippetSource>$(MSBuildThisFileDirectory)..\..\EffectWeaver\_snippets\</EwSnippetSource>
  </PropertyGroup>
  <Target Name="SyncEwSnippets" Condition="Exists('$(EwSnippetSource)')">
    <ItemGroup>
      <EwSnippet Include="$(EwSnippetSource)**\*.glsl" Exclude="$(EwSnippetSource)effects\**;$(EwSnippetSource)tools\**" />
    </ItemGroup>
    <Copy SourceFiles="@(EwSnippet)" DestinationFiles="@(EwSnippet->'$(MSBuildThisFileDirectory)srcData\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!--
    The built in snippet library (SnippetLibrary.Builtin): srcData\<folder>\<Id>.glsl is brotli compressed to data\<folder>\<Id>.glsl.br (like the
    web assets of the other projects) and embedded as "snippets/<folder>/<Id>.glsl.br", decompressed when the library loads.
    -OptimizeShaders False: the snippets are stored as they are (no stripping or minification; they are inserted into effects as source code).
  -->
  <Target Name="EmbedLocal" BeforeTargets="BeforeBuild" DependsOnTargets="SyncEwSnippets">
    <Exec Command="..\_tools\compress\Compress.exe -Methods br -OptimizeShaders False .\srcData\*+ .\data" />
    <ItemGroup>
      <EwSnippetData Include="data\**\*.glsl.br" />
      <EmbeddedResource Include="@(EwSnippetData)" LogicalName="snippets/%(EwSnippetData.RecursiveDir)%(EwSnippetData.Filename)%(EwSnippetData.Extension)" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
