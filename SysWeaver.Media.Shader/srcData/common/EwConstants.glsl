// =============================================================================
//  EwConstants - Shared math constants
// =============================================================================
//  Pi and friends as preprocessor defines (usable in const expressions).
//
//  EW_PI      : pi
//  EW_TAU     : 2 * pi (full turn)
//  EW_HALF_PI : pi / 2
//  EW_INV_PI  : 1 / pi
//  EW_SQRT3   : sqrt(3)
//
//  Requires: -
//  Docs    : EwConstants.md
// =============================================================================
#define EW_PI      3.14159265359
#define EW_TAU     6.28318530718
#define EW_HALF_PI 1.57079632679
#define EW_INV_PI  0.31830988618
#define EW_SQRT3   1.73205080757
