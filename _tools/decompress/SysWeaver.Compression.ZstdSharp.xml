    <members>
        <member name="T:SysWeaver.Compression.CompZstdSharp">
            <summary>
            A Zstandard ("zstd", extension "zstd") plug-in using the fully managed ZstdSharp.Port library, through <see cref="T:SysWeaver.Compression.CompStreamCodec`2"/>.
            Registered with priority 1 once <see cref="M:SysWeaver.Compression.CompZstdSharp.Register"/> is called.
            </summary>
            <remarks>
            Uses zstd level 1 / 9 / 22 for <see cref="F:SysWeaver.Compression.CompEncoderLevels.Fast"/> / <see cref="F:SysWeaver.Compression.CompEncoderLevels.Balanced"/> / <see cref="F:SysWeaver.Compression.CompEncoderLevels.Best"/>.
            The <see cref="T:ZstdSharp.Compressor"/> / <see cref="T:ZstdSharp.Decompressor"/> contexts are pooled (per level for compressors) and reset between uses.
            Concatenated (and skippable) zstd frames are decompressed.
            </remarks>
        </member>
